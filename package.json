{
  "name": "ghostdrop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "contract",
    "sdk",
    "web",
    "storage"
  ],
  "scripts": {
    "build": "npm run build -w ghostdrop-contract && npm run build -w ghostdrop-api && npm run build -w ghostdrop-storage && npm run build -w ghostdrop-web",
    "contract:compile": "npm run compact -w ghostdrop-contract",
    "contract:test": "npm run test -w ghostdrop-contract",
    "dev": "concurrently -k -n storage,web -c magenta,green \"npm run dev -w ghostdrop-storage\" \"npm run dev -w ghostdrop-web\"",
    "dev:storage": "npm run dev -w ghostdrop-storage",
    "test": "npm run test -w ghostdrop-contract && npm run test -w ghostdrop-api && npm run test -w ghostdrop-storage && npm run test -w ghostdrop-web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "proof-server:up": "node scripts/proof-server.mjs up",
    "proof-server:down": "node scripts/proof-server.mjs down",
    "proof-server:status": "node scripts/proof-server.mjs status",
    "services:check": "node scripts/check-services.mjs",
    "deployment:record": "node scripts/record-deployment.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "buffer": "^6.0.3",
    "fp-ts": "^2.16.11",
    "pino": "^10.3.1",
    "rxjs": "^7.8.2",
    "semver": "^7.8.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.0",
    "@types/semver": "^7.7.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "overrides": {
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "smoldot": "npm:empty-npm-package@1.0.0",
    "vite": "8.3.0"
  }
}
